# Copy this file to a new file named exactly ".env" and keep ONLY ONE of the three options below.
# Lines starting with # are ignored.

# --- OPTION 1 (free, runs on your computer, no account): Ollama ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# --- OPTION 2 (free cloud tier, needs a free API key): any OpenAI-compatible provider ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=paste-your-free-key-here
# LLM_MODEL=copy-a-current-model-name-from-the-provider-docs
#
#   Google Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter (free models):  LLM_BASE_URL=https://openrouter.ai/api/v1

# --- OPTION 3 (paid): Claude through the Anthropic API ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=paste-your-key-here
